{
    "name": "claude-exporter",
    "version": "0.1.0",
    "private": true,
    "description": "Privacy-first Chrome extension to export claude.ai conversations to Markdown, HTML, and PDF.",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "oxlint",
        "format": "oxfmt .",
        "format:check": "oxfmt --check ."
    },
    "dependencies": {
        "markdown-it": "^15.0.2"
    },
    "devDependencies": {
        "@crxjs/vite-plugin": "^2.0.0-beta.25",
        "@types/chrome": "^0.0.270",
        "@types/node": "^24.19.1",
        "oxfmt": "^0.44.0",
        "oxlint": "^1.59.0",
        "typescript": "^5.6.2",
        "vite": "^5.4.6",
        "vitest": "^2.1.1"
    }
}
