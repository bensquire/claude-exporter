// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`toHtml > snapshots simple conversation 1`] = `
"<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Hello world</title>
<style>
  :root {
    --fg: #1a1a1a;
    --fg-muted: #666;
    --bg: #ffffff;
    --bg-human: #f4f4f6;
    --bg-code: #0f1115;
    --fg-code: #e6e6e6;
    --border: #e4e4e7;
  }
  * { box-sizing: border-box; }
  body {
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color: var(--fg);
    background: var(--bg);
    margin: 0;
    padding: 2rem 1rem;
  }
  main { max-width: 780px; margin: 0 auto; }
  h1 { font-size: 1.75rem; margin: 0 0 0.25rem; }
  .meta { color: var(--fg-muted); font-size: 0.875rem; margin: 0 0 2rem; }
  .turn {
    border: 1px solid var(--border);
    border-radius: 8px;
    margin: 1rem 0;
    overflow: hidden;
    page-break-inside: avoid;
    break-inside: avoid;
  }
  .turn-header {
    padding: 0.5rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    background: var(--bg-human);
    border-bottom: 1px solid var(--border);
  }
  .turn-human .turn-header { background: #eef2ff; }
  .turn-body { padding: 1rem; }
  .turn-body > * + * { margin-top: 0.75rem; }
  p { margin: 0.5rem 0; }
  pre.code, .tool-use pre, .tool-result pre, .unknown pre, .thinking pre {
    background: var(--bg-code);
    color: var(--fg-code);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    overflow-x: auto;
    font: 13px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .code-title { font-size: 0.8rem; color: var(--fg-muted); margin-bottom: 0.25rem; }
  .tool-label { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--fg-muted); margin-bottom: 0.25rem; }
  .tool-result.is-error pre { border-left: 3px solid #dc2626; }
  .attachments ul { margin: 0.25rem 0 0 1.25rem; padding: 0; }
  .attachments .size { color: var(--fg-muted); font-size: 0.85em; }
  details.thinking { border-left: 3px solid #d4d4d8; padding-left: 0.75rem; }
  details.thinking summary { cursor: pointer; color: var(--fg-muted); font-size: 0.875rem; }

  @media print {
    body { padding: 0; font-size: 11pt; }
    main { max-width: none; }
    .turn { border-color: #ccc; break-inside: avoid; page-break-inside: avoid; }
    details.thinking { display: none; }
    pre.code, .tool-use pre, .tool-result pre, .unknown pre {
      background: #f6f8fa;
      color: #111;
      border: 1px solid #e4e4e7;
    }
    a { color: inherit; text-decoration: none; }
    h1 { font-size: 16pt; }
  }
</style>
</head>
<body>
<main>
  <h1>Hello world</h1>
  <p class="meta">Created 2026-04-01T10:00:00Z</p>
  <section class="turn turn-human">
  <header class="turn-header">Human</header>
  <div class="turn-body">
<div class="text"><p>Hello, Claude!</p></div>

  </div>
</section>
<section class="turn turn-assistant">
  <header class="turn-header">Assistant</header>
  <div class="turn-body">
<details class="thinking"><summary>Thinking</summary><pre>Greeting the user.</pre></details>
<div class="text"><p>Hi there! How can I help?</p></div>

  </div>
</section>
</main>
</body>
</html>
"
`;
